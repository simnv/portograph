  .overlay-endpoint{fill:#7b7fc4;stroke:none}
  .node-body:where(.provider){fill:#283448}
  .icon-tile.provider{fill:#7f8aa9;stroke:#c3cadf}
  .node-icon.provider{stroke:#ffffff}
