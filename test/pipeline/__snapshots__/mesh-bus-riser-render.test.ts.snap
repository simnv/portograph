;strokeColor=light-dark(#7b7fc4,#7b7fc4);strokeWidth=1.5;opacity=70;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="pg-layer~overlay" source="pg-node~a2" target="pg-busJoint~mesh-bus-1~a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg-busMark~mesh-bus-1~a2" style="ellipse;html=1;fillColor=light-dark(#7b7fc4,#7b7fc4);strokeColor=none;points=[];" vertex="1" parent="pg-node~a2"><mxGeometry x="23" y="45" width="4" height="4" as="geometry"/></mxCell><mxCell id="pg-busJoint~mesh-bus-1~a3" style="ellipse;html=1;fillColor=none;strokeColor=none;points=[];" vertex="1" parent="pg-node~a3"><mxGeometry x="30" y="103" width="2" height="2" as="geometry"/></mxCell><mxCell id="pg-busStub~mesh-bus-1~a3" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=light-dark(#7b7fc4,#7b7fc4);strokeWidth=1.5;opacity=70;exitX=0.62;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="pg-layer~overlay" source="pg-node~a3" target="pg-busJoint~mesh-bus-1~a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg-busMark~mesh-bus-1~a3" style="ellipse;html=1;fillColor=light-dark(#7b7fc4,#7b7fc4);strokeColor=none;points=[];" vertex="1" parent="pg-node~a3"><mxGeometry x="29" y="45" width="4" height="4" as="geometry"/></mxCell><mxCell id="pg-bus~mesh-bus-1" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=light-dark(#7b7fc4,#7b7fc4);strokeWidth=1.5;opacity=70;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="pg-layer~overlay" source="pg-busJoint~mesh-bus-1~a1" target="pg-busJoint~mesh-bus-1~a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg-busJoint~mesh-bus-1~riser-from" style="ellipse;html=1;fillColor=none;strokeColor=none;points=[];" ve