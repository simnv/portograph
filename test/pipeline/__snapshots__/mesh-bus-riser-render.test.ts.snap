  .pill.tbr{fill:#f5f5f8;stroke:#7a7a7d}
  .pill-label.tbr{fill:#000000}
  .node-body:where(.rr){fill:#d9d9d9}
  .icon-tile.rr{fill:#2b2b2d;stroke:#2b2b2d}
  .node-icon.rr{stroke:#ffffff}
  .pill.rr{fill:#f5f5f8;stroke:#7a7a7d}
  .pill-label.rr{fill:#000000}
  .link-line.dotted{stroke:#5d5d60;stroke-dasharray:1 3;stroke-linecap:round}
  .link-line.dashed{stroke:#5d5d60;stroke-dasharray:4 4}
  .link-line.signal{stroke:#5d5d60;stroke-dasharray:4 4}
