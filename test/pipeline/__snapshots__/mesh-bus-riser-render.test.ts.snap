  .pill.loopback{fill:none;stroke:#98989b}
  .pill.up{stroke:#000000}
  .pill.down{stroke:#5d5d60;stroke-dasharray:2 2}
  .pill.admin-down{stroke:#7a7a7d;stroke-dasharray:2 2;fill:#ffffff}
  .pill-label.admin-down{fill:#7a7a7d}
  .pill.degraded{stroke:#000000;stroke-dasharray:3 1}
  .port.unused{opacity:0.45}
}
.pg-halo{paint-order:stroke fill;stroke-width:4px;stroke-linejoin:round;stroke-opacity:1;stroke-dasharray:none}
.pg-halo.pg-halo-0{stroke:#f2f2f3}
.pg-halo.pg-halo-1{stroke:#f0f4fa}
.pg-halo.pg-halo-2{stroke:#eff5fd}
@media (prefers-color-scheme: dark){
  .pg-halo.pg-halo-0{stroke:#1d2d3d}
  .pg-halo.pg-halo-1{stroke:#253a4f}
  .pg-halo.pg-halo-2{stroke:#294057}
}
@media print{
  .pg-halo.pg-halo-0{stroke:#ffffff}
  .pg-halo.pg-halo-1{stroke:#ffffff}
  .pg-halo.pg-halo-2{stroke:#ffffff}
}
.pg-w-1{stroke-width:1px!important}
.pg-w-1_5{stroke-width:1.5px!important}
.pg-w-3_75{stroke-width:3.75px!important}
