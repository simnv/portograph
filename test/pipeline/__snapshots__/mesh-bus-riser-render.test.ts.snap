  .link-line.dotted{stroke:#7dbcc4;stroke-dasharray:1 3;stroke-linecap:round}
  .link-line.dashed{stroke:#a2a5d9;stroke-dasharray:4 4}
  .link-line.signal{stroke:#a2a5d9;stroke-dasharray:4 4}
  .pill.uplink{fill:#597ea3}
