idth="83.53564453125" height="11" as="geometry"/></mxCell><mxCell id="pg-legend" style="group;html=1;points=[];" vertex="1" parent="pg-layer~legend"><mxGeometry x="12" y="691.5" width="204.53955078125" height="13" as="geometry"/></mxCell><mxCell id="pg-legendRow~symbol:router" value="Router" style="html=1;fillColor=none;strokeColor=none;points=[];align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacingLeft=16;fontFamily=Arial, Helvetica, sans-serif;fontSize=9;fontColor=light-dark(#424244,#d6ebff);" vertex="1" parent="pg-legend"><mxGeometry x="0.5" y="0.5" width="45.01318359375" height="12" as="geometry"/></mxCell><mxCell id="pg-legendBody~symbol:router" style="html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=light-dark(#dbeff1,#1e3945);strokeColor=light-dark(#749dc4,#94bce3);strokeWidth=1;points=[];" vertex="1" parent="pg-legendRow~symbol:router"><mxGeometry x="-2" y="-2" width="16" height="16" as="geometry"/></mxCell><mxCell id="pg-legendSwatch~symbol:router" style="sketch=0;html=1;aspect=fixed;points=[];shape=mxgraph.cisco19.rect;prIcon=router;fillColor=light-dark(#4f9aa6,#4f9aa6);strokeColor=light-dark(#ffffff,#ffffff);" vertex="1" parent="pg-legendRow~symbol:router"><mxGeometry x="0" y="0" width="12" height="12" as="geometry"/></mxCell><mxCell id="pg-legendRow~line:default" value="Default link" style="html=1;fillColor=none;strokeColor=none;points=[];align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacingLeft=28;fontFamily=Arial, Helvetica, sans-serif;fontSize=9;fontColor=light-dark(#424244,#d6ebff);" vertex="1" parent="pg-legend"><mxGeometry x="63.51318359375" y="1" width="74.52099609375" height="11" as="geometry"/></mxCell><mxCell id="pg-legendSwatch~line:default" style="shape=line;html=1;points=[];strokeColor=light-dark(#2c455d,#b5d9fd);strokeWidth=1.5;" vertex="1" parent="pg-legendRow~line:default"><mxGeometry x="0" y="4.5" width="24" height="2" as="geometry"/></mxCell><mxCell id="pg-legendRow~line:sync" value="sync"