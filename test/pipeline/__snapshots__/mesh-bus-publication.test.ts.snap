  .overlay-line{stroke:#7a7a7d;stroke-opacity:0.55}
  .overlay-endpoint{fill:#7a7a7d;stroke:none}
  .node-body:where(.provider){fill:#f7f7f8}
  .icon-tile.provider{fill:#d4d4d7;stroke:#2b2b2d}
  .node-icon.provider{stroke:#2b2b2d}
  .pill.provider{fill:#f5f5f8;stroke:#7a7a7d}
  .pill-label.provider{fill:#000000}
  .node-body:where(.router){fill:#e2e2e2}
  .icon-tile.router{fill:#5d5d60;stroke:#2b2b2d}
  .node-icon.router{stroke:#ffffff}
  .pill.router{fill:#f5f5f8;stroke:#7a7a7d}
  .pill-label.router{fill:#000000}
  .node-body:where(.tbr){fill:#e7e7e8}
  .icon-tile.tbr{fill:#7a7a7d;stroke:#2b2b2d}
  .node-icon.tbr{stroke:#ffffff}
  .pill.tbr{fill:#f5f5f8;stroke:#7a7a7d}
  .pill-label.tbr{fill:#000000}
  .node-body:where(.rr){fill:#d9d9d9}
  .icon-tile.rr{fill:#2b2b2d;stroke:#2b2b2d}
  .node-icon.rr{stroke:#ffffff}
  .pill.rr{fill:#f5f5f8;stroke:#7a7a7d}
  .pill-label.rr{fill:#000000}
  .link-line.dotted{stroke:#5d5d60;stroke-dasharray:1 3;stroke-linecap:round}
  .link-line.dashed{stroke:#5d5d60;stroke-dasharray:4 4}
  .link-line.signal{stroke:#5d5d60;stroke-dasharray:4 4}
  .pill.uplink{fill:#b7b7ba}
  .pill-label.uplink{fill:#000000}
  .pill.downlink{fill:#f5f5f8}
  .pill-label.downlink{fill:#000000}
  .pill.peer{fill:#d4d4d7}
  .pill-label.peer{fill:#000000}
  .pill.mgmt{fill:#e7e7ea}
  .pill-label.mgmt{fill:#000000}
  .pill.lag{fill:#98989b}
  .pill-label.lag{fill:#000000}
  .pill.loopback{fill:none;stroke:#98989b}
  .pill.up{stroke:#000000}
  .pill.down{stroke:#5d5d60;stroke-dasharray:2 2}
  .pill.admin-down{stroke:#7a7a7d;stroke-dasharray:2 2;fill:#ffffff}
  .pill-label.admin-down{fill:#7a7a7d}
