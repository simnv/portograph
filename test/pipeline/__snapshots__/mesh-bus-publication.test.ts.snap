exports[`the bus publishes member paths, scores, renders and exports (ticket 84) > snapshots the SVG and the draw.io export of a-bus-across-cantons-crosses-the-canton-edges > svg 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" class="portograph network" viewBox="19 -43.5 602.906254 420" width="602.906254" height="420"><defs><style type="text/css">.pg-canvas{fill:#f2f2f3}
