{
  "name": "portograph",
  "version": "0.1.0",
  "description": "YAML in, a laid-out diagram (SVG) out: nodes with ports, grouped into tiers, links routed per region.",
  "type": "module",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=22.0.0"
  },
  "bin": {
    "portograph": "bin/portograph.mjs"
  },
  "main": "./dist/portograph.umd.cjs",
  "module": "./dist/portograph.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/portograph.js",
      "require": "./dist/portograph.umd.cjs"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/node.d.cts",
      "import": "./dist/node.cjs",
      "require": "./dist/node.cjs"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.json --noEmit --module NodeNext --moduleResolution NodeNext",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "~8.55.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "elkjs": "0.12.0",
    "postcss": "^8.5.28",
    "web-worker": "1.4.1",
    "yaml": "^2.9.0"
  }
}
