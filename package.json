{
  "name": "portograph",
  "version": "0.1.0",
  "description": "YAML in, a laid-out diagram (SVG) out: nodes with ports, grouped into tiers, links routed per region.",
  "keywords": [
    "diagram",
    "network-diagram",
    "layout",
    "svg",
    "yaml",
    "ports",
    "orthogonal-routing",
    "elkjs",
    "libavoid",
    "drawio"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/simnv/portograph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simnv/portograph.git"
  },
  "bugs": {
    "url": "https://github.com/simnv/portograph/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "portograph": "bin/portograph.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/portograph.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/portograph.umd.cjs"
      }
    },
    "./node": {
      "types": "./dist/node.d.cts",
      "import": "./dist/node.cjs",
      "require": "./dist/node.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "node scripts/test-runner.mjs",
    "test:full": "node scripts/test-runner.mjs --full",
    "test:runner": "node --test scripts/test-runner.check.mjs scripts/test-runner-lock.check.mjs scripts/test-runner-safety.check.mjs scripts/test-runner-hardening.check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.json --noEmit --module NodeNext --moduleResolution NodeNext",
    "lint": "eslint . && node scripts/check-no-raw-vitest.mjs && node scripts/check-box-writers.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "corpus": "node scripts/with-lock.mjs corpus -- npm run corpus:run --silent --",
    "corpus:run": "vite build --logLevel error && node scripts/corpus.mjs",
    "sweep": "node scripts/with-lock.mjs sweep -- npm run sweep:run --silent --",
    "sweep:run": "vite build --logLevel error && node scripts/sweep.mjs",
    "r3": "node scripts/with-lock.mjs r3 -- npm run r3:run --silent --",
    "r3:run": "vite build --logLevel error && node scripts/r3.mjs",
    "gate:compare": "node scripts/gate-compare.mjs",
    "gate:branch": "node scripts/with-lock.mjs gate:branch -- node scripts/gate-branch.mjs",
    "png": "node scripts/png.mjs",
    "prepack": "vite build 1>&2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "elkjs": "0.12.0",
    "libavoid-js": "0.5.0-beta.5",
    "web-worker": "1.5.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
